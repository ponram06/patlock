Windows Registry Editor Version 5.00

; VM ONLY, manual recovery/reference file; prefer install.ps1 with its VM checks.
; The DLL must already be copied to the VM's System32 directory.
; Manual registrations must also be removed manually with unregister.reg.
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{21d42e91-a8c0-4e63-b5d7-372d8585982c}\InprocServer32]
@="PatlockProvider.dll"
"ThreadingModel"="Apartment"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{21d42e91-a8c0-4e63-b5d7-372d8585982c}]
@="Patlock Pattern Provider"
